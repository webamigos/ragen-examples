{
  "name": "ragenai-aws-lambda-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.js --external:aws-sdk",
    "package": "npm run build && cd dist && zip -q -r function.zip handler.js && echo 'Created dist/function.zip'",
    "invoke:local": "tsx src/local.ts"
  },
  "dependencies": {
    "@webamigos/ragen-sdk-ts": "^0.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "dotenv": "^16.4.5",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
